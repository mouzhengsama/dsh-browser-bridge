{
  "name": "@dsh/browser-bridge",
  "version": "1.0.0",
  "description": "Protected Streamable HTTP MCP bridge for exposing a local workspace to web AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/dsh-plugin.d.ts",
      "import": "./dist/dsh-plugin.js",
      "default": "./dist/dsh-plugin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-bridge": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouzhengsama/dsh-browser-bridge.git"
  },
  "homepage": "https://github.com/mouzhengsama/dsh-browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/mouzhengsama/dsh-browser-bridge/issues"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "axios": "^1.13.4"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-lsp": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-shell": ">=0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-lsp": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/keyring": "^1.3.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "localtunnel": "^2.0.2",
    "vscode-jsonrpc": "^9.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.1",
    "@deepseek-ai/dsh-lsp": "0.0.1-rc.1",
    "@deepseek-ai/dsh-shell": "0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
